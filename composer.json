{
    "name": "trecenode/filament-mermaid-field",
    "description": "Filament Mermaid Field",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Trecenode\\FilamentMermaidField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Trecenode\\FilamentMermaidField\\FilamentMermaidFieldServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Danilo Ulloa",
            "email": "info@13node.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "filament/forms": "^5.0",
        "filament/support": "^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Trecenode\\FilamentMermaidField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "filament/filament": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
